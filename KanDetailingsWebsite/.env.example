# Copy to .env and fill in. Never commit the real .env.

# --- Web server ---
PORT=3000

# Password staff type at /staff.html to reach the dashboard.
STAFF_PASSWORD=change-me

# --- Discord bridge (all optional; leave DISCORD_TOKEN blank to run without the bot) ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Server (guild) the bot posts into
DISCORD_GUILD_ID=
# Channel that receives a card for every new booking
DISCORD_BOOKINGS_CHANNEL_ID=
# Channel where a thread is opened per booking for customer <-> staff chat.
# Can be the same id as DISCORD_BOOKINGS_CHANNEL_ID.
DISCORD_CHAT_CHANNEL_ID=
# Role pinged on a new booking (id only, no <@&>). Optional.
DISCORD_NOTIFY_ROLE_ID=
